{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@shared/*": ["src/shared/*"] },
    "outDir": "node_modules/.tsc/node"
  },
  "include": ["electron.vite.config.ts", "src/main/**/*", "src/shared/**/*"]
}
